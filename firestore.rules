rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userRole() {
      return hasUserDoc()
        ? get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role
        : "";
    }

    // =========================
    // ROLES
    // =========================

    function isAdmin() {
      return signedIn() && (
        userRole() == "admin"
        || request.auth.token.email == "user1@abdo124206.com"
      );
    }

    function isDriver() {
      return signedIn() && (
        userRole() == "driver"
        || (
          request.auth.token.email != null
          && request.auth.token.email.matches(
            "^driver[1-5]@abdo124206\\.com$"
          )
        )
      );
    }

    function isCustomer() {
      return signedIn() && !isAdmin() && !isDriver();
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "customer";

      allow read: if signedIn()
        && (
          isAdmin()
          || request.auth.uid == userId
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();
    }


    // =========================
    // DRIVER ASSIGNMENTS
    // =========================

    match /users/{userId}/assignments/{assignmentId} {

      allow read: if signedIn()
        && (
          isAdmin()
          || request.auth.uid == userId
        );

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================
    // ORDERS
    // =========================

    match /orders/{orderId} {

      // Customer creates a new order
      allow create: if isCustomer()
        && request.resource.data.customer.uid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.driver.uid == "";


      // Read orders
      allow read: if signedIn()
        && (
          // Admin
          isAdmin()

          ||

          // Customer
          (
            isCustomer()
            && resource.data.customer.uid == request.auth.uid
          )

          ||

          // Driver
          (
            isDriver()
            && (
              resource.data.driver.uid == request.auth.uid
              || resource.data.assignedDriverUid == request.auth.uid
            )
          )
        );


      // Update orders
      allow update: if

        // Admin can update everything
        isAdmin()

        ||

        // Driver can update assigned order status
        (
          isDriver()

          && (
            resource.data.driver.uid == request.auth.uid
            || resource.data.assignedDriverUid == request.auth.uid
          )

          && request.resource.data.customer.uid
              == resource.data.customer.uid

          && request.resource.data.driver.uid
              == resource.data.driver.uid

          && request.resource.data.total
              == resource.data.total

          && request.resource.data.items
              == resource.data.items

          && request.resource.data.status in [
            "ready",
            "on_the_way",
            "delivered"
          ]
        )

        ||

        // Customer can cancel a new order
        // or update allowed customer fields
        (
          isCustomer()

          && resource.data.customer.uid == request.auth.uid

          && (
            (
              resource.data.status == "new"

              && request.resource.data.status == "cancelled"

              && request.resource.data.customer.uid
                  == resource.data.customer.uid

              && request.resource.data.items
                  == resource.data.items

              && request.resource.data.total
                  == resource.data.total
            )

            ||

            (
              request.resource.data.customer.uid
                  == resource.data.customer.uid

              && request.resource.data.items
                  == resource.data.items

              && request.resource.data.total
                  == resource.data.total

              && request.resource.data.status
                  == resource.data.status

              && request.resource.data.keys().hasOnly([
                "customer",
                "notes",
                "items",
                "total",
                "status",
                "driver",
                "createdAt",
                "customerMessage"
              ])
            )
          )
        );


      // Only admin can delete orders
      allow delete: if isAdmin();


      // =========================
      // ORDER CHAT
      // =========================

      match /messages/{messageId} {

        // Read chat
        allow read: if signedIn()
          && (

            // Admin
            isAdmin()

            ||

            // Customer
            (
              isCustomer()

              && get(
                /databases/$(database)/documents/orders/$(orderId)
              ).data.customer.uid == request.auth.uid
            )

            ||

            // Driver
            (
              isDriver()

              && (
                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.driver.uid == request.auth.uid

                ||

                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.assignedDriverUid == request.auth.uid
              )
            )
          );


        // Send chat message
        allow create: if signedIn()
          && (

            // Admin
            isAdmin()

            ||

            // Customer
            (
              isCustomer()

              && get(
                /databases/$(database)/documents/orders/$(orderId)
              ).data.customer.uid == request.auth.uid
            )

            ||

            // Driver
            (
              isDriver()

              && (
                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.driver.uid == request.auth.uid

                ||

                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.assignedDriverUid == request.auth.uid
              )
            )
          );


        // Only admin can edit/delete messages
        allow update, delete: if isAdmin();
      }
    }


    // =========================
    // MENU
    // =========================

    match /menu/{itemId} {

      // Everyone can view menu
      allow read: if true;

      // Admin only can modify menu
      allow write: if isAdmin();
    }


    // =========================
    // DRIVERS
    // =========================

    match /drivers/{driverId} {

      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.uid == request.auth.uid
        );

      allow write: if isAdmin();
    }
  }
}
