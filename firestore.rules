rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // AUTH
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userRole() {
      return hasUserDoc()
        ? get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role
        : "";
    }


    // =========================
    // ROLES
    // =========================

    function isAdmin() {
      return signedIn() && userRole() == "admin";
    }

    function isDriver() {
      return signedIn() && userRole() == "driver";
    }

    function isCustomer() {
      return signedIn()
        && !isAdmin()
        && !isDriver();
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // إنشاء حساب العميل
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "customer";

      // الأدمن يرى الجميع، والمستخدم يرى نفسه
      allow read: if signedIn()
        && (
          isAdmin()
          || request.auth.uid == userId
        );

      // الأدمن يعدل أي حساب
      // المستخدم يعدل بياناته بدون تغيير الـ role
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.role == "customer"
          && request.resource.data.role == "customer"
        );

      allow delete: if isAdmin();
    }


    // =========================
    // DRIVER ASSIGNMENTS
    // =========================

    match /users/{userId}/assignments/{assignmentId} {

      allow read: if signedIn()
        && (
          isAdmin()
          || request.auth.uid == userId
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // ORDERS
    // =========================

    match /orders/{orderId} {

      // إنشاء طلب جديد
      // أي مستخدم مسجل الدخول يقدر ينشئ طلبًا لنفسه
      allow create: if signedIn()
        && request.resource.data.customer.uid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.driver.uid == "";


      // قراءة الطلبات
      allow read: if signedIn()
        && (
          // Admin
          isAdmin()

          ||

          // Customer
          (
            isCustomer()
            && resource.data.customer.uid == request.auth.uid
          )

          ||

          // Driver
          (
            isDriver()
            && (
              resource.data.driver.uid == request.auth.uid
              || resource.data.assignedDriverUid == request.auth.uid
            )
          )
        );


      // تعديل الطلبات
      allow update: if

        // Admin
        isAdmin()

        ||

        // Driver
        (
          isDriver()

          && (
            resource.data.driver.uid == request.auth.uid
            || resource.data.assignedDriverUid == request.auth.uid
          )

          && request.resource.data.customer.uid
              == resource.data.customer.uid

          && request.resource.data.driver.uid
              == resource.data.driver.uid

          && request.resource.data.total
              == resource.data.total

          && request.resource.data.items
              == resource.data.items

          && request.resource.data.status in [
            "ready",
            "on_the_way",
            "delivered"
          ]
        )

        ||

        // Customer يلغي الطلب الجديد فقط
        (
          isCustomer()

          && resource.data.customer.uid == request.auth.uid

          && resource.data.status == "new"

          && request.resource.data.status == "cancelled"

          && request.resource.data.customer.uid
              == resource.data.customer.uid

          && request.resource.data.items
              == resource.data.items

          && request.resource.data.total
              == resource.data.total
        );


      // حذف الطلب للأدمن فقط
      allow delete: if isAdmin();


      // =========================
      // ORDER CHAT
      // =========================

      match /messages/{messageId} {

        // قراءة الرسائل
        allow read: if signedIn()
          && (

            // Admin
            isAdmin()

            ||

            // Customer
            (
              isCustomer()

              && get(
                /databases/$(database)/documents/orders/$(orderId)
              ).data.customer.uid == request.auth.uid
            )

            ||

            // Driver
            (
              isDriver()

              && (
                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.driver.uid == request.auth.uid

                ||

                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.assignedDriverUid == request.auth.uid
              )
            )
          );


        // إرسال الرسائل
        allow create: if signedIn()
          && (

            // Admin
            isAdmin()

            ||

            // Customer
            (
              isCustomer()

              && get(
                /databases/$(database)/documents/orders/$(orderId)
              ).data.customer.uid == request.auth.uid
            )

            ||

            // Driver
            (
              isDriver()

              && (
                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.driver.uid == request.auth.uid

                ||

                get(
                  /databases/$(database)/documents/orders/$(orderId)
                ).data.assignedDriverUid == request.auth.uid
              )
            )
          );


        // الأدمن فقط يعدل أو يحذف الرسائل
        allow update, delete: if isAdmin();
      }
    }


    // =========================
    // MENU
    // =========================

    match /menu/{itemId} {

      allow read: if true;

      allow write: if isAdmin();
    }


    // =========================
    // DRIVERS
    // =========================

    match /drivers/{driverId} {

      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.uid == request.auth.uid
        );

      allow write: if isAdmin();
    }
  }
}
